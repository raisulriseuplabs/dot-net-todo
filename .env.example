# Copy this file to .env and change the values. .env is gitignored.

# HMAC signing key for JWTs. Must be at least 32 characters; longer random is better.
# Generate one: openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# First admin account, created on first start if no admin exists yet.
ADMIN_EMAIL=admin@todo.local
ADMIN_PASSWORD=change-me-Admin123!

# Swagger UI at http://localhost:8080/swagger (set to false for a real deployment)
SWAGGER_ENABLED=true
